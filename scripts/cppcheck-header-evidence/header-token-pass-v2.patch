+// File membership only: no line/branch or individual checker coverage is inferred.
+class NicoNativeTokenFiles {
+public:
+    void capture(const Tokenizer &tokenizer, std::size_t &bytes, std::size_t &entries) {
+        for (const Token *tok = tokenizer.tokens(); tok; tok = tok->next()) {
+            if (static_cast<std::size_t>(tok->fileIndex()) >= tokenizer.list.getFiles().size()) {
+                invalid = true;
+                return;
+            }
+            std::string name;
+            try { name = tokenizer.list.getOrigFile(tok); }
+            catch (const std::out_of_range &) { invalid = true; return; }
+            if (name.empty()) { invalid = true; return; }
+            if (files.find(name) != files.end()) continue;
+            const std::size_t cost = name.size() + 128;
+            if (entries >= 4096 || cost > 1048576 - bytes) { overflow = true; return; }
+            bytes += cost;
+            ++entries;
+            files.insert(std::move(name));
+        }
+        captured = true;
+    }
+    void write(std::ostream &out, const char *stage) const {
+        out << "<token_membership stage=\"" << stage << "\" captured=\""
+            << (captured ? "true" : "false") << "\" invalid=\""
+            << (invalid ? "true" : "false") << "\" overflow=\""
+            << (overflow ? "true" : "false") << "\">\n";
+        for (const auto &name : files)
+            out << "<token_file file=\"" << ErrorLogger::toxml(name) << "\"/>\n";
+        out << "</token_membership>\n";
+    }
+    std::set<std::string> files;
+    bool captured = false, invalid = false, overflow = false;
+};
