+// Bound actual serialized output, including escaped values and all configurations.
+// A limit hit leaves an incomplete document, which the consumer must reject.
+class NicoNativeTraceBuffer : public std::streambuf {
+public:
+    void open(const char *path) {
+        file.open(path, std::ios::app | std::ios::binary);
+        const auto position = file.tellp();
+        if (!file || position < 0 || position > 1048576) { file.close(); return; }
+        bytes = static_cast<std::size_t>(position);
+    }
+    bool isOpen() const { return file.is_open(); }
+protected:
+    std::streamsize xsputn(const char *s, std::streamsize n) override {
+        if (n < 0 || static_cast<std::size_t>(n) > 1048576 - bytes) return 0;
+        file.write(s, n);
+        if (!file) return 0;
+        bytes += static_cast<std::size_t>(n);
+        return n;
+    }
+    int_type overflow(int_type ch) override {
+        if (traits_type::eq_int_type(ch, traits_type::eof())) return traits_type::not_eof(ch);
+        const char value = traits_type::to_char_type(ch);
+        return xsputn(&value, 1) == 1 ? ch : traits_type::eof();
+    }
+    int sync() override { file.flush(); return file ? 0 : -1; }
+private:
+    std::ofstream file;
+    std::size_t bytes = 0;
+};
+class NicoNativeTraceStream : public std::ostream {
+public:
+    NicoNativeTraceStream() : std::ostream(nullptr) { rdbuf(&buffer); }
+    void open(const char *path) { buffer.open(path); if (!buffer.isOpen()) setstate(std::ios::badbit); }
+    bool is_open() const { return buffer.isOpen(); }
+private:
+    NicoNativeTraceBuffer buffer;
+};
