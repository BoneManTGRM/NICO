+// Trusted opt-in observer; it never selects or alters analysis.
+class NicoNativeFileTrace {
+public:
+    explicit NicoNativeFileTrace(const std::string &file) {
+        const char *path = std::getenv("CPPCHECK_NICO_NATIVE_PROVENANCE");
+        if (!path || !*path) return;
+        stream.open(path);
+        if (stream) stream << "<nico_native schema=\"nico.cppcheck-header-token-pass.v2\" file=\""
+                           << ErrorLogger::toxml(file) << "\">\n";
+    }
+    ~NicoNativeFileTrace() {
+        if (stream) stream << "<file_end normal_return=\"" << (normalReturn ? "true" : "false")
+                           << "\"/></nico_native>\n";
+    }
+    bool enabled() const { return stream.is_open(); }
+    void endedNormally() { normalReturn = true; }
+    void configuration(const std::string &cfg, const Preprocessor &preprocessor,
+                       const char *disposition, bool checksComplete,
+                       const NicoNativeTokenFiles &tokenized, const NicoNativeTokenFiles &parsed,
+                       bool normalPassStarted) {
+        if (!stream) return;
+        const auto &observer = preprocessor.nicoObserver();
+        bool unsupported = false;
+        for (const auto &entry : observer.usage) if (entry.kind == "forced_not_loaded") unsupported = true;
+        const bool complete = checksComplete && preprocessor.nicoPreprocessReturned()
+            && !preprocessor.nicoPreprocessHadOutput() && !observer.overflow
+            && tokenized.captured && parsed.captured && !tokenized.invalid && !parsed.invalid
+            && !tokenized.overflow && !parsed.overflow && normalPassStarted
+            && !unsupported && !Settings::terminated();
+        stream << "<configuration cfg=\"" << ErrorLogger::toxml(cfg)
+               << "\" disposition=\"" << disposition << "\" checks_completed=\""
+               << (checksComplete ? "true" : "false") << "\" completed=\""
+               << (complete ? "true" : "false") << "\" preprocessing_returned=\""
+               << (preprocessor.nicoPreprocessReturned() ? "true" : "false")
+               << "\" preprocessing_had_output=\"" << (preprocessor.nicoPreprocessHadOutput() ? "true" : "false")
+               << "\" observation_overflow=\"" << (observer.overflow ? "true" : "false")
+               << "\" token_logical_remap_observed=\"" << (observer.logicalLocationRemapped ? "true" : "false")
+               << "\" normal_pass_started=\"" << (normalPassStarted ? "true" : "false") << "\">\n";
+        const auto &dui = preprocessor.nicoDui();
+        stream << "<effective std=\"" << ErrorLogger::toxml(dui.std) << "\">\n";
+        for (const auto &x : dui.defines) stream << "<define value=\"" << ErrorLogger::toxml(x) << "\"/>\n";
+        for (const auto &x : dui.undefined) stream << "<undef value=\"" << ErrorLogger::toxml(x) << "\"/>\n";
+        for (const auto &x : dui.includePaths) stream << "<include_path value=\"" << ErrorLogger::toxml(x) << "\"/>\n";
+        for (const auto &x : dui.includes) stream << "<forced_input value=\"" << ErrorLogger::toxml(x) << "\"/>\n";
+        stream << "</effective>\n";
+        for (const auto &entry : observer.usage)
+            stream << "<include file=\"" << ErrorLogger::toxml(entry.file) << "\" parent=\""
+                   << ErrorLogger::toxml(entry.parent) << "\" kind=\"" << entry.kind
+                   << "\" entered=\"" << (entry.entered ? "true" : "false") << "\"/>\n";
+        tokenized.write(stream, "pre_simplification");
+        parsed.write(stream, "normal_form_ast_validated");
+        stream << "</configuration>\n";
+        stream.flush();
+    }
+private:
+    NicoNativeTraceStream stream;
+    bool normalReturn = false;
+};
+class NicoNativeConfigurationTrace {
+public:
+    NicoNativeConfigurationTrace(NicoNativeFileTrace &file, Preprocessor &preprocessor,
