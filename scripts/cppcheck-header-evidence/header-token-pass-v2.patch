+    bool checksComplete = false, normalPassStarted = false;
+    NicoNativeTokenFiles tokenized, parsed;
+    std::size_t tokenMembershipBytes = 0, tokenMembershipEntries = 0;
+private:
+    NicoNativeFileTrace &file;
+    Preprocessor &preprocessor;
+    const std::string &cfg;
+};
