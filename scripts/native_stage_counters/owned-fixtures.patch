+    void nicoGroupingRealDeclarationCallbacks() {
+        SimpleTokenList tokens("template < > class Box ;");
+        Token* start = tokens.front();
+        Token* name = start->tokAt(4);
+        TemplateSimplifier::TokenAndName declaration(start, "ns", name, start->tokAt(2));
+        ASSERT(declaration.isSpecialization());
+        ASSERT(declaration.isClass());
+        ASSERT(!declaration.isAlias() && !declaration.isFriend());
+        std::map<std::string, std::list<const Token*>> groups;
+        groups[declaration.fullName()].push_back(declaration.nameToken());
+        groups[declaration.fullName()].push_back(declaration.nameToken());
+        ASSERT_EQUALS(2U, groups.at("ns :: Box").size());
+        name->str("Renamed");
+        ASSERT_EQUALS("Renamed", groups.at("ns :: Box").front()->str());
+        ASSERT_EQUALS("ns :: Box", declaration.fullName());
+        start->swapWithNext();
+        ASSERT(declaration.token() == start->next());
+        ASSERT(declaration.nameToken() == name);
+        ASSERT(declaration.isSpecialization() && declaration.isClass());
+        start->deleteNext();
+        ASSERT(declaration.token() == nullptr);
+        ASSERT(declaration.nameToken() == name);
+        ASSERT_EQUALS("ns :: Box", declaration.fullName());
+        ASSERT_EQUALS("Renamed", groups.at("ns :: Box").back()->str());
+        groups.clear();
+        ASSERT(groups.empty());
+    }
+
+    void nicoGroupingRealCopyUnregister() {
+        SimpleTokenList tokens("Box ;");
+        Token* name = tokens.front();
+        TemplateSimplifier::TokenAndName original(name, "ns");
+        ASSERT_EQUALS(1U, name->templateSimplifierPointers()->size());
+        {
+            TemplateSimplifier::TokenAndName copy(original);
+            ASSERT_EQUALS(2U, name->templateSimplifierPointers()->size());
+            name->swapWithNext();
+            ASSERT(original.token() == name->next());
+            ASSERT(copy.token() == name->next());
+        }
+        ASSERT_EQUALS(1U, name->next()->templateSimplifierPointers()->size());
+        name->deleteNext();
+        ASSERT(original.token() == nullptr);
+        ASSERT_EQUALS("ns :: Box", original.fullName());
+    }
+
+    void nicoGroupingRepeatedExpansion() {
+        const char code[] = "template <class T> T f(T val) { T a; }\nf<int>(10);";
+        const char expected[] = "int f<int> ( int val ) ; f<int> ( 10 ) ; int f<int> ( int val ) { int a ; }";
+        for (unsigned i = 0; i < 8; ++i)
+            ASSERT_EQUALS(expected, tok(code));
     }
 
