# Local storage
NICO_HOME=.nico
NICO_DB_PATH=.nico/nico.sqlite3
NICO_REPORT_DIR=.nico/reports

# Local API
NICO_API_HOST=127.0.0.1
NICO_API_PORT=8000
NICO_API_RELOAD=true
NICO_CORS_ORIGINS=http://localhost:3000

# Defensive execution boundaries
NICO_AUTONOMY_LEVEL=1
NICO_ENABLE_SCANNER_EXECUTION=true
NICO_ALLOW_PROJECT_COMMANDS=false
NICO_ENABLE_FULL_HISTORY_SECRET_SCAN=false
NICO_MAX_REPO_BYTES=150000000
NICO_TOOL_TIMEOUT_SECONDS=45
NICO_TOTAL_SCAN_TIMEOUT_SECONDS=300
NICO_MAX_TOOL_OUTPUT=12000

# Production-only examples; leave unset for local SQLite operation.
# DATABASE_URL=postgresql://user:password@host:5432/nico
# NICO_ADMIN_TOKEN=generate-a-distinct-site-admin-secret
# NICO_COMPREHENSIVE_OPERATOR_PASSWORD=generate-a-long-specialist-password
# NICO_OPERATOR_SESSION_SIGNING_SECRET=generate-an-independent-32-byte-or-longer-random-secret
# NICO_SPECIALIST_SESSION_TTL_SECONDS=14400
# NICO_SPECIALIST_LOGIN_LIMIT_PER_MINUTE=10
# NICO_SPECIALIST_REQUEST_LIMIT_PER_MINUTE=240
# NICO_SPECIALIST_INTAKE_LIMIT_PER_HOUR=12
# NICO_RELEASE_COMMIT_SHA=full-40-character-backend-commit-sha
# NICO_FRONTEND_BUILD_COMMIT_SHA=full-40-character-frontend-commit-sha
# NICO_EXPECTED_BUILD_SHA=full-40-character-commit-sha

# Temporary migration compatibility only. New specialist deployments should use
# NICO_COMPREHENSIVE_OPERATOR_PASSWORD and remove this legacy variable after rotation.
# NICO_SARA_OPERATOR_PASSWORD=legacy-existing-operator-secret
